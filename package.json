{
  "name": "@shuji-bonji/s1000d-brex-mcp",
  "version": "0.1.0",
  "description": "MCP server that reads S1000D® BREX (Business Rules Exchange) data modules and checks data modules against them. Not affiliated with ASD.",
  "keywords": ["mcp", "s1000d", "brex", "business-rules", "ietm", "ietp", "technical-publications", "xml"],
  "author": "shuji-bonji",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/shuji-bonji/s1000d-brex-mcp.git" },
  "bugs": "https://github.com/shuji-bonji/s1000d-brex-mcp/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "s1000d-brex-mcp": "dist/index.js" },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:spec": "S1000D_SPEC_TESTS=1 vitest --run",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@shuji-bonji/s1000d-core": "file:../../lib/s1000d-core"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.53.0",
    "vitest": "^2.1.0"
  },
  "engines": { "node": ">=22.0.0" }
}
